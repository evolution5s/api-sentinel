{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git remote:*)",
      "Bash(git symbolic-ref:*)",
      "Bash(gh repo:*)",
      "Bash(python checkup.py:*)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(pip show:*)",
      "Bash(railway status:*)",
      "Bash(railway logs:*)",
      "Bash(railway whoami:*)",
      "Bash(railway link:*)",
      "Bash(railway setup:*)",
      "Bash(railway --version)",
      "Bash(railway --help)",
      "Bash(railway run:*)",
      "Bash(railway variable list:*)",
      "Bash(railway variables list:*)",
      "Bash(railway deployment list:*)",
      "Bash(railway environment list:*)",
      "Bash(railway environment config:*)",
      "Bash(railway service list:*)",
      "Bash(railway service status:*)",
      "WebSearch",
      "WebFetch(domain:core.telegram.org)",
      "mcp__railway__list_variables",
      "mcp__railway__list_deployments",
      "mcp__railway__get_logs",
      "mcp__railway__whoami",
      "mcp__railway__docs_search",
      "mcp__railway__docs_fetch",
      "mcp__railway__environment_status",
      "mcp__railway__get_service_config",
      "Write",
      "Edit",
      "Read"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(.env*)",
      "Bash(railway variable delete:*)",
      "Bash(railway variable set:*)",
      "Bash(railway service delete:*)",
      "Bash(railway volume delete:*)",
      "Bash(railway volume add:*)"
    ]
  }
}
