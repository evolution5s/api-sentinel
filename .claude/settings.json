{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(python checkup.py:*)",
      "Bash(railway status:*)",
      "Bash(railway logs:*)",
      "Bash(railway variable list:*)",
      "Bash(railway deployment list:*)",
      "Write",
      "Edit",
      "Read"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Read(.env*)",
      "Bash(railway variable delete:*)",
      "Bash(railway service delete:*)"
    ]
  }
}
